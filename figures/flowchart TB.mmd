    Output["✅ 異常確率出力<br/>30d / 60d / 90d"]
    
    Input --> GraniteTS
    Input --> Statistical
    
    TSEmb --> Fusion
    StatFeatures --> Fusion
    
    Fusion --> Classifier
    Classifier --> Output
    
